{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(.venv/bin/python smoke_test.py)",
      "Bash(python smoke_test.py)",
      "Bash(python3 smoke_test.py)",
      "Bash(.venv/bin/python -m py_compile app.py)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.streamlit/secrets.toml)",
      "Bash(curl *)",
      "Bash(wget *)"
    ]
  }
}
